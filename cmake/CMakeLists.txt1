set(IMGUI_BINDER_INCLUDE_DIR 
    ${CMAKE_SOURCE_DIR}/test/thirdparty/imgui_binder/
    ${CMAKE_SOURCE_DIR}/test/thirdparty/imgui_binder/imgui
    ${CMAKE_SOURCE_DIR}/test/thirdparty/imgui_binder/implot)

include_directories(
    ${IMGUI_BINDER_INCLUDE_DIR})

file(GLOB_RECURSE IMGUI_SRCS
    ${CMAKE_SOURCE_DIR}/test/thirdparty/imgui_binder/imgui/*.cpp
    ${CMAKE_SOURCE_DIR}/test/thirdparty/imgui_binder/implot/*.cpp
)

find_package(glfw3 REQUIRED)
find_package(OpenGL REQUIRED)
include_directories(${GLFW_INCLUDE_DIRS})
add_library(imgui_binder SHARED ${IMGUI_SRCS})
target_link_libraries(imgui_binder glfw ${OPENGL_LIBRARIES} ${GLEW_LIBRARIES})
install(TARGETS imgui_binder LIBRARY DESTINATION ${CATKIN_PACKAGE_LIB_DESTINATION})

include_directories(
    ${CMAKE_SOURCE_DIR}/test/thirdparty/imgui_binder/imgui
    ${CMAKE_SOURCE_DIR}/test/thirdparty/imgui_binder/implot
    ${CMAKE_SOURCE_DIR}/modules/bag_io/test/
    ${CMAKE_SOURCE_DIR}/modules/bag_io/include/
    ${CMAKE_SOURCE_DIR}/modules/bag_io/include/lidar
    ${CMAKE_SOURCE_DIR}/modules/bag_io/include/lidar/include
)

