if(DEFINED BUILD_UTEST)
    message("start to build utest!!!!!")
    file(GLOB_RECURSE GTEST_CPP
      ${CMAKE_SOURCE_DIR}/test/gtest/src/utility/*.cpp
      ${CMAKE_SOURCE_DIR}/test/gtest/src/grid_fusion/*.cpp
      ${CMAKE_SOURCE_DIR}/test/gtest/src/groundline_fusion/*.cpp
      ${CMAKE_SOURCE_DIR}/test/gtest/src/obstacle_fusion/*.cpp
      ${CMAKE_SOURCE_DIR}/test/gtest/src/roadmark_fusion/*.cpp
      ${CMAKE_SOURCE_DIR}/test/gtest/src/uss_psd/*.cpp
      ${CMAKE_SOURCE_DIR}/test/gtest/src/slot_fusion/*.cpp)

    file(GLOB_RECURSE FUSION_SRC_FILES
        ${CMAKE_SOURCE_DIR}/src/utility/*.cpp
        ${CMAKE_SOURCE_DIR}/src/groundline_fusion/*.cpp
        ${CMAKE_SOURCE_DIR}/src/slot_fusion/*.cpp
        ${CMAKE_SOURCE_DIR}/src/grid_fusion/*.cpp
        ${CMAKE_SOURCE_DIR}/src/obstacle_fusion/*.cpp
        ${CMAKE_SOURCE_DIR}/src/roadmark_fusion/*.cpp
        ${CMAKE_SOURCE_DIR}/src/uss_psd/app/*.cpp
        ${CMAKE_SOURCE_DIR}/src/uss_psd/searching/*.cpp
        ${CMAKE_SOURCE_DIR}/src/uss_psd/parking/*.cpp
        ${CMAKE_SOURCE_DIR}/src/uss_psd/common/mathlib/*.cpp
        ${CMAKE_SOURCE_DIR}/src/uss_psd/common/psd_math/*.cpp
        ${CMAKE_SOURCE_DIR}/interface/*.cpp
        ${CMAKE_SOURCE_DIR}/exec/*.cpp
    )


    # 设置代码覆盖率的相关参数

    include_directories(
      ${CMAKE_SOURCE_DIR}/modules/parking_fusion/src/
      ${CMAKE_SOURCE_DIR}/modules/parking_fusion/src/groundline_fusion/
      ${CMAKE_SOURCE_DIR}/modules/parking_fusion/src/obstacle_fusion/
      ${CMAKE_SOURCE_DIR}/modules/parking_fusion/src/roadmark_fusion/
      ${CMAKE_SOURCE_DIR}/modules/parking_fusion/src/uss_psd_fusion/
      ${CMAKE_SOURCE_DIR}/modules/parking_fusion/src/slot_fusion/
      ${CMAKE_SOURCE_DIR}/modules/parking_fusion/src/grid_fusion/
      ${CMAKE_SOURCE_DIR}/modules/parking_fusion/src/utility/
      ${CMAKE_SOURCE_DIR}/modules/parking_fusion/interface/
    )

    add_executable(parking_fusion_test ${GTEST_CPP} ${FUSION_SRC_FILES})
    target_link_libraries(parking_fusion_test  bag_io ${LIBS} camera_model)

    install(TARGETS parking_fusion_test
    ARCHIVE DESTINATION ${CATKIN_PACKAGE_LIB_DESTINATION}
    LIBRARY DESTINATION ${CATKIN_PACKAGE_LIB_DESTINATION}
    RUNTIME DESTINATION ${CATKIN_PACKAGE_BIN_DESTINATION}
    )
endif()

