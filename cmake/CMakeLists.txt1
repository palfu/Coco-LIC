    ${CMAKE_SOURCE_DIR}/test/visualize/imgui_pf.cpp 
    ${CMAKE_SOURCE_DIR}/test/visualize/app.cpp
    ${CMAKE_SOURCE_DIR}/test/visualize/data_process.cpp
    ${CMAKE_SOURCE_DIR}/test/visualize/viz_node.cpp
    ${CMAKE_SOURCE_DIR}/test/visualize/viz_menu.cpp
    ${CMAKE_SOURCE_DIR}/test/visualize/viz.cpp 
    ${CMAKE_SOURCE_DIR}/modules/bag_io/test/debug_message.cpp)
target_link_libraries(app imgui_binder bag_io ${LIBS} parking_fusion camera_model)

add_executable(test_scenario 
    ${CMAKE_SOURCE_DIR}/test/scenario_filter/test_scenario.cpp 
    ${CMAKE_SOURCE_DIR}/test/scenario_filter/parking_scenario.cpp 
    ${CMAKE_SOURCE_DIR}/test/scenario_filter/odom_checker.cpp 
    ${CMAKE_SOURCE_DIR}/test/scenario_filter/bag_split.cpp)

target_link_libraries(test_scenario  bag_io ${LIBS} parking_fusion camera_model)

