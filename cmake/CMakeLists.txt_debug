)

message("common_MAIN_DIR :  ${common_MAIN_DIR}")
include_directories(${common_MAIN_DIR}/proto/)
# set(proto_gen_folder ${CMAKE_CURRENT_BINARY_DIR}/debug)
file(GLOB PROTO_FILES    ${CMAKE_SOURCE_DIR}/test/proto/*.proto)
message("debug proto : ${PROTO_FILES}")
PROTOBUF_GENERATE_CPP(${proto_gen_folder} PROTO_SRCS PROTO_HDRS "${PROTO_FILES}")
file(GLOB DEBUG_SRCS  ${proto_gen_folder}/*.cpp)
add_library(pnc_debug SHARED ${PROTO_SRCS})
target_link_libraries(pnc_debug ${PKG_LIBRARIES})

file(GLOB_RECURSE GTEST_CPP
${CMAKE_SOURCE_DIR}/gtest/src/utility/*.cpp
${CMAKE_SOURCE_DIR}/gtest/src/slot_fusion/*.cpp)
