set(PROTOBUF_IMPORT_DIRS 
	${common_MAIN_DIR}/proto/common
	${common_MAIN_DIR}/proto/map 
	${common_MAIN_DIR}/proto/Planning
	${common_MAIN_DIR}/proto/Perception
	${common_MAIN_DIR}/proto/Routing 
	${common_MAIN_DIR}/proto/Control 
	${common_MAIN_DIR}/proto/Sensor
	${common_MAIN_DIR}/proto/Routing
	${common_MAIN_DIR}/proto/Perception
